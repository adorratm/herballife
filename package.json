    "js-yaml@npm:5.2.1": "5.2.3",
    "js-yaml@npm:5.2.2": "5.2.3",
    "multer": "2.4.0",
    "baseline-browser-mapping": "2.11.21",
    "brace-expansion@npm:^1.1.7": "1.1.21",
    "brace-expansion@npm:^2.0.2": "2.1.7",
    "brace-expansion@npm:^5.0.0": "5.0.12",
    "brace-expansion": "5.0.12",
    "shell-quote": "1.12.0",
    "http-cache-semantics": "4.3.0",
    "node-forge": "portal:./.yarn/vendor/node-forge"
  },
  "volta": {
    "node": "26.12.1",
