{
  "name": "herballife",
  "private": true,
  "workspaces": [
    "api",
    "frontend",
    "admin",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "yarn workspace @herballife/api start:dev",
    "dev:frontend": "yarn workspace @herballife/frontend dev",
    "dev:admin": "yarn workspace @herballife/admin dev",
    "build": "yarn workspaces foreach -Apt run build",
    "build:api": "yarn workspace @herballife/api build",
    "build:frontend": "yarn workspace @herballife/frontend build",
    "build:admin": "yarn workspace @herballife/admin build",
    "migration:run": "yarn workspace @herballife/api migration:run",
    "migration:generate": "yarn workspace @herballife/api migration:generate",
    "lint": "yarn workspaces foreach -Apt run lint",
    "stock:upload": "node scripts/upload-stock-images.mjs",
    "s3:cors": "node scripts/apply-s3-cors.cjs"
  },
  "resolutions": {
    "@aws-sdk/credential-provider-node": "3.972.87",
    "@aws-sdk/credential-provider-process": "3.972.75",
    "@aws-sdk/types": "3.974.6",
    "qs": "^6.16.0",
    "@bull-board/api": "9.5.0",
    "@bull-board/ui": "9.5.0",
    "uuid": "^14.0.1",
    "postcss": "^8.5.23",
    "fast-uri": "3.1.8",
    "browserslist": "^4.28.8",
    "decode-uri-component": "0.5.0",
    "@xmldom/xmldom@npm:^0.8.8": "0.8.15",
    "@xmldom/xmldom@npm:^0.8.11": "0.8.15",
    "@xmldom/xmldom@npm:^0.9.10": "0.9.12",
    "sharp": "0.35.5",
    "proxy-addr": "2.0.8",
    "source-map-js": "1.2.2",
    "compression": "1.8.2",
    "braces": "portal:./.yarn/vendor/braces",
    "tar": "^7.5.22",
    "ip-address": "10.7.3",
    "undici": "8.11.2",
    "axios": "1.20.0",
    "engine.io": "6.6.11",
    "js-yaml@npm:^3.13.1": "3.15.2",
    "js-yaml@npm:^4.1.0": "4.3.2",
    "js-yaml@npm:^4.3.0": "4.3.2",
    "js-yaml@npm:4.3.1": "4.3.2",
