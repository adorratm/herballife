# Production — herbalkapida.com (Hetzner / paylaşımlı VPS)
# Sunucuda: cp deploy/.env.production.example deploy/.env && nano deploy/.env

# ── Host portları (TTEN 3000/4000, Portfolio 3100–3102/5433/6380 ile çakışmaz) ──
FRONTEND_HOST_PORT=3200
ADMIN_HOST_PORT=3201
API_HOST_PORT=3202
POSTGRES_HOST_PORT=5434
REDIS_HOST_PORT=6381

# ── Domain URL'leri (canlı: herbalkapida.com) ──
# Sunum (geçici): bkz. deploy/DEMO.md
FRONTEND_URL=https://herbalkapida.com
ADMIN_URL=https://admin.herbalkapida.com
API_URL=https://api.herbalkapida.com
NEXT_PUBLIC_SITE_URL=https://herbalkapida.com
NEXT_PUBLIC_ADMIN_URL=https://admin.herbalkapida.com
NEXT_PUBLIC_API_URL=https://api.herbalkapida.com
NEXT_PUBLIC_CDN_URL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Frontend/admin container SSR → Docker ağı (compose zaten set eder; dokümantasyon)
# API_INTERNAL_URL=http://api:4000

# ── API / JWT ──
API_PORT=4000
JWT_SECRET=degistir-uzun-rastgele-secret-uret
JWT_EXPIRES_IN=7d
# İsteğe bağlı seed bootstrap — günlük yetki Kullanıcılar UI / admin_allowlist
# ADMIN_ALLOWLIST=admin@example.com

# Dump import sonrası false bırakın. Boş DB + şema yoksa ilk boot için true.
DATABASE_SYNCHRONIZE=false
# Migration'lar deploy.sh içinde one-shot (`node dist/migrate.js`) çalışır.
# API container boot'ta migration ÇALIŞTIRMAZ (canlıyı düşürmemek için).
# Acil / manuel: container içinde DATABASE_MIGRATIONS_RUN=true ile başlatabilirsiniz.
DATABASE_MIGRATIONS_RUN=false
# İlk deploy: products tablosu boşsa deploy.sh otomatik `node dist/seed.js` çalıştırır.
# Zorla: SEED_ON_DEPLOY=1 bash deploy/deploy.sh (veya Actions workflow_dispatch seed)

# ── PostgreSQL ──
POSTGRES_USER=herbalkapida
POSTGRES_PASSWORD=degistir-guclu-sifre
POSTGRES_DB=herbalkapida

# ── Google OAuth ──
# 401 invalid_client = Client ID boş/yanlış veya Console’da silinmiş.
# Google Cloud → Credentials → Web client:
#   Authorized redirect URIs:
#   https://api.herbalkapida.com/auth/google/callback
#   https://api.herbalkapida.com/auth/google/admin/callback
# Client ID/Secret’ı aşağıya yapıştırıp API container’ı recreate edin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.herbalkapida.com/auth/google/callback
GOOGLE_ADMIN_CALLBACK_URL=https://api.herbalkapida.com/auth/google/admin/callback
APPLE_CLIENT_ID=tr.herbalkapida.ops
APPLE_TEAM_ID=

# ── Ödeme ──
PAYMENT_PROVIDER=paytr
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=0
PAYTR_DEBUG_ON=0
PAYTR_NO_INSTALLMENT=0
PAYTR_MAX_INSTALLMENT=0
# Canlıda mock ödeme KAPALI tutun (açmak için bilinçli olarak true)
PAYTR_ALLOW_MOCK=false
# PayTR bildirim URL: https://api.herbalkapida.com/payments/paytr/callback

# AWS S3 (boşsa yerel uploads volume)
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_CDN_URL=

# ── Instagram (Medya /medya sayfası) ──
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_USERNAME=

# ── Redis (compose override eder; burada dokümantasyon) ──
REDIS_URL=redis://redis:6379
BULL_BOARD_PATH=/admin/queues

# ── Mail (varsayılan: info@herbalkapida.com) ──
MAIL_FROM="Herbal Kapıda <info@herbalkapida.com>"
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=info@herbalkapida.com
# Gmail uygulama şifresi (Google Hesap → Güvenlik → Uygulama şifreleri)
MAIL_PASS=
# Sipariş bildirimi (admin). Boşsa DB admin_allowlist; o da yoksa info@
ORDER_ALERT_EMAILS=info@herbalkapida.com

# ── WhatsApp ──
WHATSAPP_PROVIDER=console
WHATSAPP_FROM=+905553332211
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=

# ── Pricing ──
TAX_RATE_PERCENT=20
TAX_INCLUDED=true
DEFAULT_SHIPPING_FEE=89.90
FREE_SHIPPING_OVER=750
NEXT_PUBLIC_FREE_SHIPPING_OVER=750
ABANDONED_CART_HOURS=4
ABANDONED_CART_SECOND_HOURS=24
LOW_STOCK_THRESHOLD=10
LOW_STOCK_ALERT_EMAILS=
LOW_STOCK_SCAN_INTERVAL_HOURS=24
MARKETPLACE_SYNC_ENABLED=true
MARKETPLACE_SYNC_INTERVAL_MINUTES=60
